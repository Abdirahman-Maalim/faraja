apiVersion: v1
kind: Secret
metadata:
  name: faraja-db-secret
  namespace: faraja-ns
  labels:
    team: cne01
    environment: development
    project: faraja
    app: postgres
type: Opaque
stringData:
  POSTGRES_PASSWORD: change-me
  DATABASE_URL: postgresql+psycopg://postgres:change-me@faraja-db-svc:5432/faraja