# --- Postgres ---
POSTGRES_USER=faraja
POSTGRES_PASSWORD=changeme
POSTGRES_DB=faraja
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=3001

# Set this to the IP/hostname your browser will use to reach the backend.
# - Docker Desktop (Mac/Windows) running locally: http://localhost:8000
# - Remote VM (multipass, cloud, etc.): http://<vm-lan-ip>:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Must match the origin your frontend is served from (comma-separated
# for multiple). Needed for FastAPI's CORS middleware to accept requests.
FRONTEND_ORIGIN=http://localhost:3001
